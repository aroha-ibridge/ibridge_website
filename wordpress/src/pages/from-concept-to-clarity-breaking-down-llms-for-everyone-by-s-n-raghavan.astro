import { getPageSeo } from '../content/seo/pageSeoRegistry';

const pathname = '/from-concept-to-clarity-breaking-down-llms-for-everyone-by-s-n-raghavan';
const seo = getPageSeo(pathname);
---

<BaseLayout seo={seo}>
