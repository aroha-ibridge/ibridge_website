# Copy to .env and fill in values. On Vercel, set these as Environment Variables.

PUBLIC_ENQUIRY_TO_EMAIL=support@ibridge360.com

# Marketing enquiries + programs API origin (learner platform hosts /api/*)
PUBLIC_LEARNER_API_ORIGIN=https://learner.ibridge360.com

# Optional: Web3Forms access key
PUBLIC_WEB3FORMS_KEY=

# Server-only Groq key for /api/marketing-chatbot
# NEVER use PUBLIC_ or VITE_ prefix — that would ship the key to the browser.
GROQ_API_KEY=
# Must be a model your Groq key can access (list: GET /openai/v1/models).
# groq/compound-mini is NOT available on all accounts — use e.g. qwen/qwen3.8-27b
GROQ_MODEL=qwen/qwen3.8-27b

# Server-only Google Sheet append for careers applications.
# NEVER use PUBLIC_ or VITE_ — that would ship the secret to the browser.
CAREERS_SHEET_URL=
CAREERS_SHEET_SECRET=
CAREERS_SPREADSHEET_ID=

# --- AWS S3 (Resumes & Documents) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_S3_BUCKET=ibridge
AWS_S3_RESUME_FOLDER=New_Programs/CarrierPageResumes/

# --- Email Notification (DreamHost SMTP) ---
EMAIL_PROVIDER=smtp
Email_Host=smtp.dreamhost.com
Email_Port=587
Email_ID=system@ibridge360.com
Email_Pwd=
Email_Bcc=
SMTP_FROM=system@ibridge360.com
LEAD_NOTIFICATION_EMAIL=support@ibridge360.com
