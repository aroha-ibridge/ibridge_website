# Copy to .env and fill in values. On Vercel, set these as Environment Variables.

PUBLIC_ENQUIRY_TO_EMAIL=support@ibridge360.com

# Marketing enquiries + programs API origin (learner platform hosts /api/*)
PUBLIC_LEARNER_API_ORIGIN=https://learner.ibridge360.com

# Optional: Web3Forms access key
PUBLIC_WEB3FORMS_KEY=

# Server-only Groq key for /api/marketing-chatbot
# NEVER use PUBLIC_ or VITE_ prefix — that would ship the key to the browser.
GROQ_API_KEY=
# Must be a model your Groq key can access (list: GET /openai/v1/models).
# groq/compound-mini is NOT available on all accounts — use e.g. qwen/qwen3.8-27b
GROQ_MODEL=qwen/qwen3.8-27b
